// 無限の次へ（Beyond ∞）用の Firestore ルール
//
// Firebase コンソール → song-request-1e77f → Firestore Database → ルール で、
// 既存の `match /databases/{database}/documents { ... }` の中に、
// 下の「ここから」〜「ここまで」をそのまま貼り付けて「公開」を押す。
// （song-request 用の既存ルールは消さない）

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== ここから（無限の次へ） =====

    // セーブデータとプロフィール：本人だけ
    match /bi_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ランキング：誰でも読める。書けるのは本人だけ・値の範囲をチェック
    match /bi_ranking/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 12
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 1000000
        && request.resource.data.maxTier is int && request.resource.data.maxTier <= 20
        && request.resource.data.clearTime is int && request.resource.data.clearTime >= 0
        && request.resource.data.wins is int && request.resource.data.wins >= 0;
    }

    // バトル用の分身：ログインしている人なら読める。書けるのは本人だけ
    match /bi_ghosts/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ユーザー名の重複防止
    match /bi_names/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 分身が防衛したときの報酬（相手に届ける箱）
    match /bi_inbox/{id} {
      allow create: if request.auth != null
        && request.resource.data.to is string
        && request.resource.data.bp is int && request.resource.data.bp > 0 && request.resource.data.bp <= 10;
      allow read, delete: if request.auth != null && resource.data.to == request.auth.uid;
    }

    // ===== ここまで =====
  }
}
